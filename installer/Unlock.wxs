<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <!--
    Standard per-user MSI. It copies the already-built one-folder application
    and lets Windows Installer own repair, upgrade and removal. No bootstrap
    Python executable, downloader, background task or script runner is used.
  -->
  <Package Name="Unlock"
           Manufacturer="voblya-dev"
           Version="$(var.Version)"
           UpgradeCode="{B3FD7F51-E195-4878-A3E7-221B0D21BE51}"
           Scope="perUser">
    <MajorUpgrade DowngradeErrorMessage="A newer version of Unlock is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="INSTALLFOLDER" Name="Unlock" />
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="UnlockProgramMenuFolder" Name="Unlock" />
    </StandardDirectory>

    <Feature Id="MainFeature" Title="Unlock" Level="1">
      <ComponentGroupRef Id="ApplicationFiles" />
      <Component Id="StartMenuShortcut" Directory="UnlockProgramMenuFolder" Guid="{E8116E63-3B2B-4E03-9235-81A5E29D7A6B}">
        <Shortcut Id="UnlockShortcut" Name="Unlock" Target="[INSTALLFOLDER]Unlock.exe" WorkingDirectory="INSTALLFOLDER" />
        <RemoveFolder Id="RemoveUnlockProgramMenuFolder" On="uninstall" />
        <RegistryValue Root="HKCU" Key="Software\voblya-dev\Unlock" Name="Installed" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </Feature>
  </Package>

  <Fragment>
    <ComponentGroup Id="ApplicationFiles" Directory="INSTALLFOLDER">
      <Files Include="$(var.SourceDir)\**" />
    </ComponentGroup>
  </Fragment>
</Wix>
